; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=microblazeel < %s | FileCheck %s
; REQUIRES: microblaze-registered-target
; The delay slot filler hoists rtsd before a single trailing instruction,
; placing it in rtsd's delay slot.

define i32 @add_i32(i32 %a, i32 %b) {
; CHECK-LABEL: add_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    rtsd r15, 8
; CHECK-NEXT:    addk r3, r5, r6
  %r = add i32 %a, %b
  ret i32 %r
}

define i32 @sub_i32(i32 %a, i32 %b) {
; CHECK-LABEL: sub_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    rtsd r15, 8
; CHECK-NEXT:    rsubk r3, r6, r5
  %r = sub i32 %a, %b
  ret i32 %r
}

