; With two instructions before the return, only the last one fills the slot.
define i32 @three_args(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: three_args:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addk r3, r5, r6
; CHECK-NEXT:    rtsd r15, 8
; CHECK-NEXT:    addk r3, r3, r7
  %t = add i32 %a, %b
  %r = add i32 %t, %c
  ret i32 %r
}
