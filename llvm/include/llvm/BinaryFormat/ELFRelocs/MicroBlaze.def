
#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// Relocation types for Xilinx MicroBlaze (from ELF ABI).
ELF_RELOC(R_MICROBLAZE_NONE,           0)   // No relocation
ELF_RELOC(R_MICROBLAZE_32,             1)   // 32-bit absolute
ELF_RELOC(R_MICROBLAZE_32_PCREL,       2)   // 32-bit PC-relative
ELF_RELOC(R_MICROBLAZE_64_PCREL,       3)   // 64-bit PC-relative (imm+insn pair)
ELF_RELOC(R_MICROBLAZE_32_PCREL_LO,   4)   // Lower 16-bit PC-relative
ELF_RELOC(R_MICROBLAZE_64,             5)   // 64-bit absolute (imm+insn pair)
ELF_RELOC(R_MICROBLAZE_32_LO,          6)   // Lower 16-bit absolute
ELF_RELOC(R_MICROBLAZE_SRO32,          7)   // 32-bit small-data read-only
ELF_RELOC(R_MICROBLAZE_SRW32,          8)   // 32-bit small-data read-write
ELF_RELOC(R_MICROBLAZE_64_NONE,        9)   // No relocation, 64-bit placeholder
ELF_RELOC(R_MICROBLAZE_32_SYM_OP_SYM, 10)  // Symbol op symbol
ELF_RELOC(R_MICROBLAZE_GNU_VTINHERIT,  11)  // GNU C++ vtable hierarchy
ELF_RELOC(R_MICROBLAZE_GNU_VTENTRY,    12)  // GNU C++ vtable member usage
ELF_RELOC(R_MICROBLAZE_GOTPC_64,       13)  // PC-relative GOT offset
ELF_RELOC(R_MICROBLAZE_GOT_64,         14)  // GOT entry offset
ELF_RELOC(R_MICROBLAZE_PLT_64,         15)  // PLT offset (PC-relative)
ELF_RELOC(R_MICROBLAZE_REL,            16)  // Adjust by program base
ELF_RELOC(R_MICROBLAZE_JUMP_SLOT,      17)  // Create PLT entry
ELF_RELOC(R_MICROBLAZE_GLOB_DAT,       18)  // Create GOT entry
ELF_RELOC(R_MICROBLAZE_GOTOFF_64,      19)  // Offset relative to GOT
ELF_RELOC(R_MICROBLAZE_GOTOFF_32,      20)  // Lower offset relative to GOT
ELF_RELOC(R_MICROBLAZE_COPY,           21)  // Runtime copy
ELF_RELOC(R_MICROBLAZE_TLS,            22)  // TLS relocation
ELF_RELOC(R_MICROBLAZE_TLSGD,          23)  // TLS general dynamic
ELF_RELOC(R_MICROBLAZE_TLSLD,          24)  // TLS local dynamic
ELF_RELOC(R_MICROBLAZE_TLSDTPMOD32,    25)  // TLS module ID
ELF_RELOC(R_MICROBLAZE_TLSDTPREL32,    26)  // TLS offset within TLS block
ELF_RELOC(R_MICROBLAZE_TLSDTPREL64,    27)  // TLS offset within TLS block (64-bit)
ELF_RELOC(R_MICROBLAZE_TLSGOTTPREL32,  28)  // TLS offset from thread pointer
ELF_RELOC(R_MICROBLAZE_TLSTPREL32,     29)  // TLS offset from thread pointer
ELF_RELOC(R_MICROBLAZE_TEXTPCREL_64,   30)  // PC-relative TEXT offset
ELF_RELOC(R_MICROBLAZE_TEXTREL_64,     31)  // TEXT entry offset (64-bit)
ELF_RELOC(R_MICROBLAZE_TEXTREL_32_LO,  32)  // TEXT entry offset lower 32-bit
ELF_RELOC(R_MICROBLAZE_32_NONE,        33)  // 32-bit, no relocation needed
