BUILTIN(__builtin_microblaze_fsl_tecaput, "vii", "n")
BUILTIN(__builtin_microblaze_fsl_nput, "vii", "n")
BUILTIN(__builtin_microblaze_fsl_neput, "vii", "n")
BUILTIN(__builtin_microblaze_fsl_naput, "vii", "n")
